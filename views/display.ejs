<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login and Registeration Form with cashier and storage manager and store owner</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">
        <% if (successMessage) { %>
            <p class="success-message"><%= successMessage %></p>
        <% } %>
        <div id="login-form" class="form-box <%= activeForm === 'login' ? 'active' : '' %>">
            <form action="/login" method="post">
                <h2>Login</h2>
                <% if (loginError) { %>
                    <p class="error-message"><%= loginError %></p>
                <% } %>
                <input type="email" name="email" placeholder="Email" value="<%= loginFormData.email || '' %>" required>
                <input type="password" name="password" placeholder="Password" required>
                <button type="submit">Login</button>
                <p>if you don't have an account <a href="javascript:void(0)" onclick="ShowForm('register-form')">Register</a>
                </p>
            </form>
        </div>

        <div id="register-form" class="form-box <%= activeForm === 'register' ? 'active' : '' %>">
            <form action="/register" method="post">
                <h2>Register</h2>
                <% if (registerError) { %>
                    <p class="error-message"><%= registerError %></p>
                <% } %>
                <input type="text" name="name" placeholder="Name" value="<%= formData.name || '' %>" required>
                <input type="email" name="email" placeholder="Email" value="<%= formData.email || '' %>" required>
                <input type="password" name="password" placeholder="Password" required>
                <select name="role" required>
                    <option value="">Select Role</option>
                    <option value="cashier" <%= formData.role === 'cashier' ? 'selected' : '' %>>cashier</option>
                    <option value="storage-manager" <%= formData.role === 'storage-manager' ? 'selected' : '' %>>storage manager</option>
                    <option value="store-owner" <%= formData.role === 'store-owner' ? 'selected' : '' %>>store owner</option>
                </select>
                <button type="submit">Register</button>
                <% if (registerError && registerError.includes('already registered')) { %>
                    <p style="text-align: center; margin-bottom: 10px;">
                        <a href="javascript:void(0)" onclick="ShowForm('login-form')">Already have an account? Log in</a>
                    </p>
                <% } %>
                <p>if you have an account <a href="javascript:void(0)" onclick="ShowForm('login-form')">Login</a>
                </p>
            </form>
        </div>
    </div>

    <script src="/script.js"></script>
</body>

</html>
