<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Supply Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container my-5">
  <div class="row g-4">
    <!-- Add Supply Form -->
    <div class="col-md-5">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">Add New Supply</h5>
        </div>
        <div class="card-body">
          <form action="/supplier" method="post">
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input type="text" class="form-control" name="supplier-name" required placeholder="supplier name">
            </div>

            <div class="mb-3">
              <label class="form-label">Supply Label</label>
              <input type="text" class="form-control" name="supply-label" required placeholder="supply label">
            </div>

            <div class="mb-3">
              <label class="form-label">Supply Type</label>
              <input type="text" class="form-control" name="supply-type" required placeholder="e.g. Perishable, Raw Material">
            </div>

            <div class="mb-3">
              <label class="form-label">Supply Category</label>
              <select name="supply-category" required class="form-control"> 
                    <option value="">Select Category</option>
                    <option value="deli">Deli</option>
                    <option value="produce">produce</option>
                    <option value="meat-and-poultry">Meat and poultry</option>
                    <option value="dairy">Dairy</option>
                    <option value="frzen-food">Frozen Food</option>
                    <option value="baery">Bakery</option>
                    <option value="seafood">Seafood</option>
              </select> 
            </div>

            <div class="mb-3">
              <label class="form-label">Measurement Type</label>
              <select name="supply-type-of-measurement" required class="form-control"> 
                    <option value="">Select Measurement Type</option>
                    <option value="kg">kg</option>
                    <option value="g">g</option>
                    <option value="L">L</option>
                    <option value="ml">ml</option>
                    <option value="box">box</option>
                    <option value="meter">meter</option>
                    <option value="piece">piece</option>
              </select> 
            </div>

            <div class="mb-3">
              <label class="form-label">Supply Count</label>
              <input type="number" id="supply-count" step="0.01" min="0" max="999.99" class="form-control" name="supply-count" placeholder="0.00" required>
            </div>

              <div class="mb-3">
              <label class="form-label">Date of Delivery</label>
              <input type="date" class="form-control" name="date-of-delivery" required value="<%= new Date().toISOString().split('T')[0] %>">
            </div>

            <button type="submit" class="btn btn-primary w-100">Save Supply</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Inventory Table -->
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
          <h5 class="card-title mb-0">Supply Inventory</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Label</th>
                  <th>Type / Category</th>
                  <th>Measurement</th>
                  <th>Count</th>
                  <th>Delivered At</th>
                </tr>
              </thead>
              <tbody>
                <% supplies.forEach(function(supply) { %>
                  <tr>
                    <td><%= supply.id %></td>
                    <td><%= supply['supplier-name'] %></td>
                    <td><%= supply['supply-label'] %></td>
                    <td><%= supply['supply-type'] %> / <%= supply['supply-category'] %></td>
                    <td><%= supply['supply-type-of-measurement'] %></td>
                    <td><%= supply['supply-count'] %></td>
                    <td><%= supply['date-of-delivery'] %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
            <button onclick="window.location.href='/logout'">Logout</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

  <script src="/script.js"></script>

</body>

</html>