<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Supply Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <h2 class="mb-4">Welcome, <%= name %></h2>

<div class="container my-5">
  <div class="row g-4">
    <!-- Add Supply Form -->
    <div class="col-md-5">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">Add New Supply</h5>
        </div>
        <div class="card-body">
          <form action="/supplier" method="post">
             <div class="mb-3">
              <label class="form-label">Name</label>
              <input type="text" class="form-control" name="supplier-name" required placeholder="supplier name">
            </div>


            <div class="mb-3">
              <label class="form-label">Supplier Phone Number</label>
              <input type="tel" class="form-control" name="supplier-phone" required
              pattern="[0-9+\-\s()]{7,20}" placeholder="e.g. +964 750 123 4567">
            </div>

            <div class="mb-3">
              <label class="form-label">Supplier Email</label>
              <input type="email" class="form-control" name="supplier-email" required placeholder="supplier@example.com">
          </div>


            <div class="mb-3">
              <label class="form-label">Supply Label</label>
              <input type="text" class="form-control" name="supply-label" required placeholder="supply label">
            </div>

            

            <div class="mb-3">
              <label class="form-label">Supply Type</label>
              <input type="text" class="form-control" name="supply-type" required placeholder="e.g. Perishable, Raw Material">
            </div>

            <div class="mb-3">
              <label class="form-label">Supply Category</label>
              <select name="supply-category" required class="form-control"> 

                    <option value="">Select Category</option>
                    <option value="deli">Deli</option>
                    <option value="produce">produce</option>
                    <option value="meat-and-poultry">Meat and poultry</option>
                    <option value="dairy">Dairy</option>
                    <option value="frzen-food">Frozen Food</option>
                    <option value="baery">Bakery</option>
                    <option value="seafood">Seafood</option>

              </select> 
            </div>

            <div class="mb-3">
              <label class="form-label">Supply Count</label>
              <input type="number" id="supplyCount" step="0.01" min="0" max="999.99" class="form-control" name="supply-count" placeholder="0.00" required>
            </div>


            
             <div class="mb-3">
              <label class="form-label">Measurement Type</label>
              <select name="measurement-type" required class="form-control">
                <option value="">Select unit</option>
                <option value="kg">Kilogram (kg)</option>
                <option value="g">Gram (g)</option>
                <option value="lb">Pound (lb)</option>
                <option value="l">Liter (L)</option>
                <option value="ml">Milliliter (mL)</option>
                <option value="piece">Piece</option>
                <option value="box">Box</option>
                <option value="pack">Pack</option>
              </select>
              </div>
          


            <div class="mb-3">
              <label class="form-label">Supply Price</label>
              <input type="number" id="suppierPrice" step="0.01" min="0" max="999.99" class="form-control" name="supply-price" placeholder="0.00" required>
            </div>


              <div class="mb-3">
              <label class="form-label">Date of Delivery</label>
              <input type="date" class="form-control" name="date_of_delivery" required value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>

            <button type="submit" class="btn btn-primary w-100">Save Supply</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Inventory Table -->
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
          <h5 class="card-title mb-0">Supply Inventory</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Supplier</th>
                  <th>Contact</th>
                  <th>Label</th>
                  <th>Type / Category</th>
                  <th>Measurement</th>
                  <th>Count</th>
                  <th>Price</th>
                  <th>Delivered At</th>
                </tr>
              </thead>
              <tbody id="supplyTableBody">
                <!-- Dynamic rows load here -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <button onclick="window.location.href='/logout'" style="margin: 20px;">Logout</button>
  </div>
</div>


  <script>
async function loadSupplies() {
  try {
    const res = await fetch('/supplies');
    if (!res.ok) throw new Error('Failed to load supplies');
    const supplies = await res.json();

    const tbody = document.getElementById('supplyTableBody');
    tbody.innerHTML = '';

    if (!supplies.length) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = 9;
      td.textContent = 'No supplies yet.';
      tr.appendChild(td);
      tbody.appendChild(tr);
      return;
    }

    supplies.forEach(s => {
      const tr = document.createElement('tr');
      const contact = [s['supplier-phone'], s['supplier-email']].filter(Boolean).join(' / ') || '-';
      tr.innerHTML = `
        <td>${s.id}</td>
        <td>${s['supplier-name'] || '-'}</td>
        <td>${contact}</td>
        <td>${s['supply-label'] || '-'}</td>
        <td>${s['supply-type'] || '-'} / ${s['supply-category'] || '-'}</td>
        <td>${s['measurement-type'] || '-'}</td>
        <td>${s['supply-count'] ?? '-'}</td>
        <td>${s['supply-price'] ?? '-'}</td>
        <td>${s['date-of-delivery'] ? new Date(s['date-of-delivery']).toLocaleDateString() : '-'}</td>
      `;
      tbody.appendChild(tr);
    });
  } catch (err) {
    console.error(err);
  }
}

document.addEventListener('DOMContentLoaded', loadSupplies);
  </script>

  <script src="/supply-toggle.js"></script>
  <script src="/script.js"></script>

</body>

</html>