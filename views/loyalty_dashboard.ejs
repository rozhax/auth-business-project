<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loyalty - My Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/loyalty.css">
</head>
<body>
  <div class="loyalty-container">
    <div class="loyalty-card">
      <h2>Welcome, <%= customer.name %></h2>
      <div class="tier-badge tier-<%= customer.tier %>">Tier: <%= customer.tier.toUpperCase() %></div>
      <p>Points Balance: <strong><%= customer.points_balance %></strong></p>
      <p>Member since: <%= new Date(customer.created_at).toLocaleDateString() %></p>
      <a href="/loyalty/products">Browse Products</a>
      <a href="/loyalty/logout">Logout</a>
    </div>

    <div class="loyalty-card">
      <h3>Points History</h3>
      <% if (ledger.length === 0) { %>
        <p>No transactions yet.</p>
      <% } else { %>
        <table class="loyalty-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Points</th>
              <th>Note</th>
            </tr>
          </thead>
          <tbody>
            <% ledger.forEach(row => { %>
              <tr>
                <td><%= new Date(row.created_at).toLocaleDateString() %></td>
                <td><%= row.type %></td>
                <td><%= row.points %></td>
                <td><%= row.note || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
