<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register Customer - Cashier</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/register.css">
</head>
<body style="background-color: #ffff;">

  <div class="box">
    <h1>Welcome, <span><%= name %></span></h1>
    <p>This is an <span>Cashier</span> page</p>
    <button onclick="window.location.href='/logout'">Logout</button>
  </div>

  <% if (success) { %>
    <p class="success-message"><%= success %></p>
  <% } %>
  <% if (error) { %>
    <p class="error-message"><%= error %></p>
  <% } %>

  <div class="register-wrap">
    <div class="register-card">
      <h2>Register New Customer</h2>
      <form action="/cashier/register-customer" method="post">
        <label class="reg-label">Full Name</label>
        <input type="text" name="name" placeholder="Customer name" value="<%= formData && formData.name || '' %>" required>

        <label class="reg-label">Email</label>
        <input type="email" name="email" placeholder="customer@example.com" value="<%= formData && formData.email || '' %>" required>

        <label class="reg-label">Phone</label>
        <input type="tel" name="phone" placeholder="Phone number" value="<%= formData && formData.phone || '' %>">

        <label class="reg-label">Password</label>
        <input type="password" name="password" placeholder="Password" required>

        <button type="submit">Register Customer</button>
      </form>
      <p><a href="/cashier">Back to Cashier</a></p>
    </div>
  </div>

</body>
</html>
