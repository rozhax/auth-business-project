<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>cashier Page</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/register.css">
</head>

<body style="background-color: #ffff;">

  <div class="box">
    <h1>Welcome, <span><%= name %></span></h1>
    <p>This is an <span>Cashier</span> page</p>
    <button onclick="window.location.href='/logout'">Logout</button>
  </div>

  <% if (success) { %>
    <p class="success-message"><%= success %></p>
  <% } %>
  <% if (error) { %>
    <p class="error-message"><%= error %></p>
  <% } %>

  <div class="register-wrap">
    <div class="register-card">
      <h2>Record a Sale</h2>
      <form action="/sales" method="post" id="sale-form">
        <label class="reg-label">Customer (optional)</label>
        <input type="text" id="customer-search" placeholder="Search customer by name..." autocomplete="off">
        <input type="hidden" name="customerId" id="customer-id" value="">
        <div id="customer-search-results" style="position: relative;"></div>

        <label class="reg-label">Item</label>
        <input type="text" name="itemName" maxlength="200" placeholder="Item name" required>

        <label class="reg-label">Sold Price</label>
        <input type="number" name="soldPrice" step="0.01" min="0.01" max="999999.99" placeholder="0.00" required>

        <label class="reg-label">Payment Method</label>
        <select name="paymentMethod" required>
          <option value="">Select payment method</option>
          <option value="cash">Cash</option>
          <option value="card">Card</option>
        </select>


        <div id="card-fields" style="display: none;">
          <label class="reg-label">Cardholder Name</label>
          <input type="text" id="card-name" autocomplete="off" placeholder="Name on card">

          <label class="reg-label">Card Number</label>
          <input type="text" id="card-number" inputmode="numeric" autocomplete="off"
         maxlength="23" placeholder="1234 5678 9012 3456">

        <div style="display: flex; gap: 10px;">
          <div style="flex: 1;">
            <label class="reg-label">Expiry</label>
            <input type="text" id="card-expiry" inputmode="numeric" autocomplete="off"
             maxlength="5" placeholder="MM/YY">
        </div>
          <div style="flex: 1;">
            <label class="reg-label">CVV</label>
            <input type="password" id="card-cvv" inputmode="numeric" autocomplete="off"
             maxlength="4" placeholder="3-4 digits">
        </div>
      </div>

  <p id="card-error" class="error-message" style="display: none;"></p>
</div>

        <button type="submit">Add Sale</button>
      </form>
      <p style="text-align: center; margin-top: 10px;">
        <a href="/cashier/register-customer" style="color: #7494ec; text-decoration: none;">
          <button type="button" style="background: #7494ec; color: #fff; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; margin-top: 8px;">
            Customer not in system? Register them
          </button>
        </a>
      </p>
    </div>

    <div class="register-card">
      <h2>Today's Register</h2>
      <div class="totals-row">
        <div class="total-pill">Cash<br><span id="cash-total">$0.00</span></div>
        <div class="total-pill">Card<br><span id="card-total">$0.00</span></div>
        <div class="total-pill grand">Total<br><span id="grand-total">$0.00</span></div>
      </div>
      <table class="sales-table">
        <thead>
          <tr><th>Customer</th><th>Item</th><th>Price</th><th>Method</th><th>Time</th></tr>
        </thead>
        <tbody id="sales-body">
          <tr><td colspan="5">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/register.js"></script>
  <script src="/register.js"></script>
  <script src="/card-fields.js"></script>
</body>

</html>
